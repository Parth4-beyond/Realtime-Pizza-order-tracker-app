{
  "name": "realtime-pizza",
  "version": "1.0.0",
  "description": "This is our relatime pizza app",
  "main": "index.js",
  "author": "Coder's Gyan",
  "scripts": {
    "serve": "node server.js",
    "dev": "nodemon server.js",
    "development": "esbuild resources/js/app.js --bundle --target=es2017 --outfile=public/js/app.js && sass --load-path=node_modules --no-source-map resources/scss/app.scss public/css/app.css",
    "watch": "esbuild resources/js/app.js --bundle --target=es2017 --outfile=public/js/app.js --watch=forever & sass --load-path=node_modules --no-source-map --watch resources/scss/app.scss public/css/app.css",
    "production": "esbuild resources/js/app.js --bundle --minify --target=es2017 --outfile=public/js/app.js && sass --load-path=node_modules --no-source-map --style=compressed resources/scss/app.scss public/css/app.css"
  },
  "license": "MIT",
  "dependencies": {
    "axios": "^1.21.1",
    "bcrypt": "^6.0.0",
    "connect-mongo": "^4.6.0",
    "dotenv": "^8.2.0",
    "ejs": "^3.1.10",
    "express": "^4.22.3",
    "express-ejs-layouts": "^2.5.0",
    "express-flash": "^0.0.2",
    "express-session": "^1.19.0",
    "moment": "^2.31.0",
    "mongodb": "^4.17.2",
    "mongoose": "^6.13.12",
    "noty": "^3.2.0-beta",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.14",
    "sass": "^1.108.2"
  },
  "overrides": {
    "nodemon": {
      "minimatch": "^11.0.8"
    }
  }
}
